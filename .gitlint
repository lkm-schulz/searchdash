# Commit format: <type>[!][(<scope>)]: <subject>

[general]
# B6 (body-is-missing): allow empty body.
# B1 (body-max-line-length): without hard-wrapping this one must be ignored
# T1 (title-max-length): I don't like to keep myself too short
ignore=B6,B1,T1

[title-match-regex]
regex=^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test|init|misc)!?(\([a-z0-9_-]+\))?: \S.*$
